# ------------------------------------------------------------------
# Service Ora (server/index.mjs) — VOIE RECOMMANDÉE
# Ces variables ne portent pas le préfixe VITE_ : elles restent donc sur le
# serveur et n'entrent jamais dans le code envoyé au navigateur.
# ------------------------------------------------------------------

# gemini (défaut) | openai (toute API compatible OpenAI)
ORA_FOURNISSEUR=gemini
ORA_API_KEY=
ORA_MODELE=gemini-flash-latest
# Racine de l'API, pour un fournisseur compatible OpenAI. Exemples :
#   Groq      https://api.groq.com/openai/v1        modèle : llama-3.3-70b-versatile
#   Cerebras  https://api.cerebras.ai/v1            modèle : gpt-oss-120b
#   Mistral   https://api.mistral.ai/v1             modèle : mistral-large-latest
#   Ollama    http://localhost:11434/v1             modèle : llama3.1
ORA_BASE_URL=
PORT=8787
# Origine autorisée si le service et l'application sont sur deux domaines.
ORA_ORIGINE=

# ------------------------------------------------------------------
# Appel direct depuis le navigateur — DÉVELOPPEMENT UNIQUEMENT
# Vite incorpore cette clé au JavaScript servi : lisible par tout visiteur.
# Ne pas utiliser en production ; passer par le service ci-dessus.
# ------------------------------------------------------------------
VITE_GEMINI_API_KEY=

# VITE_SANS_CLE=1 neutralise la clé embarquée : build de démonstration destiné
# à un hébergement tiers, où la clé ne doit pas être diffusée.
VITE_SANS_CLE=

# VITE_ROUTER=hash : routage par ancre, pour un hébergement statique sans
# réécriture d'URL (voir npm run build:single).
VITE_ROUTER=
